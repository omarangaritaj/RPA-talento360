# Credenciales de scouts.talento360.com.co — UNA POR WORKER.
# Cada worker necesita su propia sesión: ASP.NET WebForms guarda estado
# en el servidor y sesiones compartidas se pisan el ViewState entre sí.
USER_1=usuario_uno
PASSWORD_1=clave_uno
USER_2=usuario_dos
PASSWORD_2=clave_dos
USER_3=usuario_tres
PASSWORD_3=clave_tres

# Compatibilidad: si no defines USER_1, se usa este par como credencial única.
# OJO: USER es una variable de entorno propia de Linux, por eso cargamos
# dotenv con override:true. Ver src/config.js
# USER=usuario
# PASSWORD=clave

MONGO_URI=mongodb://localhost:27017/talento360
